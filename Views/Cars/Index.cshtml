@model List<CarRental.Models.Car>

@{
    ViewData["Title"] = "Available Cars";
}

<h2 class="fw-bold text-primary">Available Cars</h2>
<p class="text-muted">Please select a car to book.</p>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No cars are available right now.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var car in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4">

                    <div class="card-body p-3 d-flex flex-column">

                        <h5 class="card-title">@car.Name</h5>

                        <p class="card-text mb-2">PKR @car.PricePerDay.ToString("N0") / day</p>

                        <div class="mb-3">
                            <span class="badge bg-success">Available</span>
                        </div>

                        <form asp-controller="Cars" asp-action="Book" method="post" class="mt-auto">

                            <input type="hidden" name="id" value="@car.Id" />

                            <button type="submit" class="btn btn-primary w-100">Book Car</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}